# Apenas valores locais de desenvolvimento; nenhuma credencial de conta real.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
HEALTH_TIMEOUT_MS=1000

PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=wagering
PGUSER=wagering_app
PGPASSWORD=local-development-only
PG_MIGRATION_USER=wagering
PG_MIGRATION_PASSWORD=local-development-only
DB_TIMEOUT_MS=10000

AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_ENDPOINT=http://127.0.0.1:4566
LOCALSTACK_PORT=4566

# Processos de worker separados da API; tempos em milissegundos.
WORKER_ROLES=references,commands,publisher
WORKER_POLL_MS=1000
WORKER_BATCH_SIZE=5
REFERENCE_TTL_MS=86400000
REFERENCE_BASE_DELAY_MS=5000
REFERENCE_MAX_DELAY_MS=300000

SQS_QUEUE_PREFIX=wager
SQS_REQUEST_TIMEOUT_MS=2000
COMMAND_VISIBILITY_SECONDS=30
COMMAND_WAIT_SECONDS=10
COMMAND_RETRY_BASE_MS=1000
COMMAND_RETRY_MAX_MS=300000

OUTBOX_RETRY_BASE_MS=1000
OUTBOX_RETRY_MAX_MS=60000

# 0 escolhe porta livre e registra em workers_started; fixe uma por processo para scrape.
WORKER_METRICS_PORT=0
